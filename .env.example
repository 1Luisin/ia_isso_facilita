# Execucao
ENABLED_MARKETPLACES=demo
PUBLISHER=telegram,whatsapp_web
DRY_RUN=true
SCAN_INTERVAL_MINUTES=30
MIN_DISCOUNT_PERCENT=20
INCLUDE_NON_PROMOTIONAL_PRODUCTS=true
MAX_OFFERS_PER_RUN=5
DATABASE_PATH=data/offers.db
BOT_API_TOKEN=

# Curadoria e copy por IA local com Ollama
AI_CURATION_ENABLED=false
AI_PROVIDER=ollama
AI_RELEVANCE_THRESHOLD=75
MAX_AI_EVALUATIONS_PER_RUN=6
BRAND_IDENTITY_PATH=config/brand_identity.json
OLLAMA_MODEL=qwen3-vl:2b-instruct
OLLAMA_USE_PRODUCT_IMAGES=true
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180

# Alternativa opcional: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45

# Shopee Affiliate Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# AliExpress Affiliate API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/sync
ALIEXPRESS_KEYWORDS=mechanical keyboard,keycaps,wireless mouse,deskmat,monitor light bar,monitor arm,laptop stand,usb hub,microphone,bluetooth headphones,gan charger,ssd nvme,portable monitor,anime action figure 25cm,vocaloid action figure,hatsune miku figure,sanrio desk accessory

# WhatsApp oficial via Groups API (opcional; não é usado no fluxo semiautomático)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GROUP_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0

# WhatsApp Web não oficial (serviço local, sujeito a bloqueios/quebras)
WHATSAPP_WEB_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_WEB_BRIDGE_TOKEN=troque-por-um-segredo-local
WHATSAPP_WEB_GROUP_ID=
WHATSAPP_WEB_BRIDGE_HOST=127.0.0.1
WHATSAPP_WEB_BRIDGE_PORT=3001
WHATSAPP_WEB_CLIENT_ID=isso-facilita
WHATSAPP_WEB_DATA_PATH=whatsapp-web-bridge/.data
WHATSAPP_WEB_MIN_SEND_INTERVAL_MS=5000

# Destino principal: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Destino alternativo: webhook HTTP
WEBHOOK_URL=
WEBHOOK_BEARER_TOKEN=

