# Execucao
ENABLED_MARKETPLACES=demo
PUBLISHER=telegram,whatsapp_web
DRY_RUN=true
SCAN_INTERVAL_MINUTES=30
MIN_DISCOUNT_PERCENT=20
MAX_OFFERS_PER_RUN=5
DATABASE_PATH=data/offers.db
BOT_API_TOKEN=

# Shopee Affiliate Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# AliExpress Affiliate API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_API_URL=https://eco.taobao.com/router/rest

# WhatsApp oficial via Groups API (opcional; não é usado no fluxo semiautomático)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GROUP_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0

# WhatsApp Web não oficial (serviço local, sujeito a bloqueios/quebras)
WHATSAPP_WEB_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_WEB_BRIDGE_TOKEN=troque-por-um-segredo-local
WHATSAPP_WEB_GROUP_ID=
WHATSAPP_WEB_BRIDGE_HOST=127.0.0.1
WHATSAPP_WEB_BRIDGE_PORT=3001
WHATSAPP_WEB_CLIENT_ID=isso-facilita
WHATSAPP_WEB_DATA_PATH=whatsapp-web-bridge/.data
WHATSAPP_WEB_MIN_SEND_INTERVAL_MS=5000

# Destino principal: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Destino alternativo: webhook HTTP
WEBHOOK_URL=
WEBHOOK_BEARER_TOKEN=

